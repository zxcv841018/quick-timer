doctype html
html
  head
    meta(charset="utf-8")
    link(rel="stylesheet",type="text/css",href="bootstrap3.min.css")
    link(rel="stylesheet",type="text/css",href="index.css")
    script(type="text/javascript",src="jquery-1.10.2.min.js")
    script(type="text/javascript",src="bootstrap3.min.js")
    script(type="text/javascript",src="index.js")
  body
    .app-shell
      .circle-area
        .circle-border
        #timer 00:01:00
        .mascot.hydrant#hydrant(title="消防栓") 🚰
        .mascot.truck#truck(title="消防噴水車") 🚒
      .controls.card
        .custom-time.row
          .col-sm-12.col-md-6.col-lg-5
            label.control-label(for="hoursInput") 小時
            input#hoursInput.form-control(type="number", min="0", value="0")
          .col-sm-12.col-md-6.col-lg-4
            label.control-label(for="minutesInput") 分鐘
            input#minutesInput.form-control(type="number", min="0", value="1")
          .col-sm-12.col-md-6.col-lg-3
            label.control-label(for="secondsInput") 秒
            input#secondsInput.form-control(type="number", min="0", value="0")
          .col-xs-12.apply-col
            a#applyCustom.btn.btn-success.btn-block(onclick="applyCustomTime()") 設定倒數時間
        .adjustments
          .btn-group
            a#minusHour.btn.btn-info.fbtn(onclick="adjust(-3600)") -1 小時
            a#minusMinute.btn.btn-info.fbtn(onclick="adjust(-60)") -1 分鐘
            a#minusHalfMinute.btn.btn-info.fbtn(onclick="adjust(-30)") -30 秒
          .btn-group.run-group
            a#toggle.btn.btn-primary(onclick="toggle()") RUN
            a#reset.btn.btn-warning(onclick="reset()") RESET
          .btn-group
            a#addHalfMinute.btn.btn-info.fbtn(onclick="adjust(30)") +30 秒
            a#addMinute.btn.btn-info.fbtn(onclick="adjust(60)") +1 分鐘
            a#addHour.btn.btn-info.fbtn(onclick="adjust(3600)") +1 小時
        p.helper 倒數完畢時，消防噴水車會繞完一圈並與消防栓相遇。
